---
/*
 * The closing block. Restraint over a call to action: a question, a line, and
 * an address set as a heading. No button, no gradient panel, no second accent
 * event.
 *
 * The address is the link rather than a `Get in touch` label, because an
 * address a reader can see is one they can act on without a round trip.
 */
import { t, type Locale } from '~/i18n';

interface Props {
  lang: Locale;
  contactEmail: string;
}

const { lang, contactEmail } = Astro.props;
const strings = t(lang);
---

<section id="kontakt" class="relative px-6 md:px-10 py-24 md:py-32 border-t border-hair">
  <div class="mx-auto max-w-(--container-content)">
    <p class="lockup text-accent-d">{strings.cta.eyebrow}</p>
    <p
      class="mt-8 max-w-[20ch] text-4xl md:text-6xl font-extrabold tracking-[-0.04em] leading-[0.95]"
    >
      {strings.ctaHeadline}
    </p>
    <a
      href={`mailto:${contactEmail}`}
      class="mt-10 inline-block text-xl md:text-3xl font-semibold tracking-[-0.02em] hover:text-accent-d transition-colors"
    >
      {contactEmail}
    </a>
  </div>
</section>
