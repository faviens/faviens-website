---
/*
 * One open role, rendered whole.
 *
 * The company half of the ad is not authored here. It is the same copy the
 * About page sets, read back from `i18n`, because a candidate who reads both
 * pages in one sitting and finds two different descriptions of the company has
 * learned something true about it. Only the recruiting-specific sentences,
 * which have no business on an About page, come from the entry's own `pitch`.
 *
 * The ad carries no application deadline, by decision of 2026-09-11: the
 * closing date is an internal one. It is absent from the frontmatter and not
 * merely hidden here, because this repository is public, and it is absent from
 * the JobPosting markup too. See AGENTS.md on what that costs.
 */
import type { CollectionEntry } from 'astro:content';
import { t, type Locale } from '~/i18n';

interface Props {
  entry: CollectionEntry<'jobs'>;
  lang: Locale;
  /** Where the `all open roles` link goes. */
  careersHref: string;
  applyEmail: string;
}

const { entry, lang, careersHref, applyEmail } = Astro.props;
const strings = t(lang);
const page = strings.jobPage;
const job = entry.data;

const details = [
  { label: page.locationLabel, value: job.location },
  { label: page.employmentLabel, value: job.employmentType },
  { label: page.workModeLabel, value: job.workMode },
  { label: page.languageLabel, value: job.workingLanguage },
];
---

<section class="px-6 md:px-10 pt-40 pb-20">
  <div class="mx-auto max-w-(--container-content)">
    <p class="lockup text-accent-d">{page.eyebrow}</p>
    <h1
      class="mt-8 max-w-[18ch] text-5xl md:text-7xl font-extrabold tracking-[-0.04em] leading-[0.95]"
    >
      {job.title}
    </h1>
    <p class="mt-10 max-w-(--container-measure) text-lg md:text-xl text-grey leading-relaxed">
      {job.bluf}
    </p>

    <dl class="mt-14 grid gap-x-12 gap-y-0 sm:grid-cols-2 max-w-(--container-measure)">
      {
        details.map((detail) => (
          <div class="border-t border-hair py-4">
            <dt class="eyebrow text-grey">{detail.label}</dt>
            <dd class="mt-2 text-base">{detail.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<section class="px-6 md:px-10 py-20 md:py-28 border-t border-hair">
  <div class="mx-auto max-w-(--container-content)">
    <p class="lockup text-accent-d">{page.companyHeading}</p>
    <div class="mt-10 space-y-8 max-w-(--container-measure)">
      {
        strings.servicePages.about.approach.map((paragraph) => (
          <p class="text-xl md:text-2xl tracking-[-0.02em] leading-snug">{paragraph}</p>
        ))
      }
      {job.pitch.map((paragraph) => <p class="text-lg text-grey leading-relaxed">{paragraph}</p>)}
    </div>
  </div>
</section>

<section class="px-6 md:px-10 py-20 md:py-28 border-t border-hair">
  <div class="mx-auto max-w-(--container-content)">
    <p class="lockup text-accent-d">{page.roleHeading}</p>
    <div class="mt-10 job-intro max-w-(--container-measure)">
      <slot />
    </div>

    <p class="mt-16 lockup text-grey">{page.responsibilitiesHeading}</p>
    <ul class="mt-6 border-t border-hair">
      {
        job.responsibilities.map((item, i) => (
          <li class="grid gap-x-8 gap-y-2 md:grid-cols-[4rem_1fr] items-start border-b border-hair py-5">
            <span class="eyebrow text-accent-d md:pt-1.5" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="max-w-[58ch] text-base leading-relaxed">{item}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section class="px-6 md:px-10 py-20 md:py-28 border-t border-hair">
  <div class="mx-auto max-w-(--container-content)">
    <p class="lockup text-accent-d">{page.qualificationsHeading}</p>
    <div class="mt-12 border-t border-hair">
      {
        job.qualifications.map((item, i) => (
          <div class="grid gap-x-8 gap-y-3 md:grid-cols-[4rem_1fr] items-start border-b border-hair py-8">
            <span class="eyebrow text-accent-d md:pt-2" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <h2 class="text-2xl md:text-3xl font-semibold tracking-[-0.025em]">{item.title}</h2>
              <p class="mt-3 max-w-[52ch] text-base text-grey leading-relaxed">
                {item.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-16 max-w-(--container-measure)">
      <p class="lockup text-accent-d">{page.applyHeading}</p>
      <p class="mt-5 text-xl md:text-2xl tracking-[-0.02em] leading-snug">{page.applyBody}</p>
      <a
        href={`mailto:${applyEmail}?subject=${encodeURIComponent(job.title)}`}
        class="mt-8 inline-block text-xl md:text-3xl font-semibold tracking-[-0.02em] hover:text-accent-d transition-colors"
      >
        {applyEmail}
      </a>
      <p class="mt-10">
        <a href={careersHref} class="text-sm link-underline hover:text-accent-d transition-colors">
          {page.backLabel}
        </a>
      </p>
    </div>
  </div>
</section>

<style>
  .job-intro :global(p) {
    max-width: var(--container-measure);
    font-size: 1.25rem;
    line-height: 1.45;
    letter-spacing: -0.02em;
  }
  .job-intro :global(p + p) {
    margin-top: 2rem;
  }
</style>
