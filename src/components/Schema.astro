---
import type { Locale } from '~/i18n';
import { COMPANY, CONTACT_EMAIL, LEGAL_NAME } from '~/data/company';
import { siteOrigin } from '~/data/site';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const SITE = siteOrigin(Astro.site).origin;

// Add `sameAs` profiles once there are any to point at.
const organization = {
  '@type': 'ProfessionalService',
  '@id': `${SITE}/#organization`,
  name: 'Faviens',
  legalName: LEGAL_NAME,
  url: SITE,
  logo: `${SITE}/og.png`,
  description:
    lang === 'de'
      ? 'Beratung für agentische KI mit Sitz in Zürich, Schweiz.'
      : 'Agentic-AI consulting based in Zürich, Switzerland.',
  address: {
    '@type': 'PostalAddress',
    streetAddress: COMPANY.address.street,
    postalCode: COMPANY.address.postalCode,
    addressLocality: COMPANY.address.city,
    addressCountry: COMPANY.address.countryCode,
  },
  // The UID, not `vatID`: the number is the register identifier, and stating
  // it as a VAT number would claim a VAT registration the company may not hold.
  identifier: {
    '@type': 'PropertyValue',
    propertyID: 'UID',
    value: COMPANY.uid,
  },
  // DACH primary, Romandie secondary, English-speaking international.
  areaServed: [
    { '@type': 'Country', name: 'Switzerland' },
    { '@type': 'Country', name: 'Germany' },
    { '@type': 'Country', name: 'Austria' },
  ],
  knowsAbout: ['Agentic AI', 'Artificial Intelligence', 'AI Strategy', 'AI Consulting'],
  email: CONTACT_EMAIL,
};

const payload = { '@context': 'https://schema.org', '@graph': [organization] };
---

<script type="application/ld+json" set:html={JSON.stringify(payload)} is:inline />
