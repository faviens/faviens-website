---
/*
 * One service on the services page.
 *
 * The numeral is the ornament: set large in the palest red of the ramp and
 * hung in the left margin, so the eye reads rhythm before it reads words. It
 * counts across the whole group rather than restarting in each stream.
 */
import type { CollectionEntry } from 'astro:content';
import { indexInGroup } from '~/data/service-groups';

interface Props {
  entry: CollectionEntry<'services'>;
  href?: string;
}

const { entry, href } = Astro.props;
const { title, bluf, topics, track } = entry.data;
const number = String(indexInGroup(track)).padStart(2, '0');
---

<article
  id={`service-${track}`}
  class="grid gap-x-8 md:grid-cols-[6rem_1fr] items-start border-b border-hair py-12 md:py-14 scroll-mt-32"
>
  <span
    class="hidden md:block text-6xl font-extrabold tracking-[-0.05em] text-t0 leading-none"
    aria-hidden="true">{number}</span
  >
  <div>
    <h3 class="text-3xl md:text-5xl font-extrabold tracking-[-0.04em] leading-[1.0]">
      {
        href ? (
          <a href={href} class="hover:text-accent-d transition-colors">
            {title.replace(/\n/g, ' ')}
          </a>
        ) : (
          title.replace(/\n/g, ' ')
        )
      }
    </h3>
    <p class="mt-6 max-w-(--container-measure) text-lg text-grey leading-relaxed">{bluf}</p>
    {
      topics && topics.length > 0 && (
        <p class="mt-6 flex flex-wrap items-baseline gap-x-3 gap-y-1 text-sm text-grey">
          {topics.map((topic, i) => (
            <>
              {i > 0 && (
                <span class="text-accent-d" aria-hidden="true">
                  ·
                </span>
              )}
              <span>{topic}</span>
            </>
          ))}
        </p>
      )
    }
    <slot />
  </div>
</article>
