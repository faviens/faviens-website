---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ContactCTA from '~/components/ContactCTA.astro';
import { t } from '~/i18n';
import { CONTACT_EMAIL } from '~/data/company';

const lang = 'en' as const;
const page = t(lang).servicePages.about;
---

<BaseLayout title={page.title} description={page.lead} lang={lang}>
  <section class="px-6 md:px-10 pt-40 pb-20">
    <div class="mx-auto max-w-(--container-content)">
      <p class="lockup text-accent-d">{page.heading}</p>
      <h1
        class="mt-8 max-w-[16ch] text-5xl md:text-8xl font-extrabold tracking-[-0.045em] leading-[0.92]"
      >
        {page.heading}
      </h1>
      <p class="mt-10 max-w-(--container-measure) text-lg md:text-xl text-grey leading-relaxed">
        {page.lead}
      </p>
    </div>
  </section>

  <section class="px-6 md:px-10 py-20 md:py-28 border-t border-hair">
    <div class="mx-auto max-w-(--container-content)">
      <p class="lockup text-accent-d">{page.approachHeading}</p>
      <div class="mt-10 space-y-8 max-w-(--container-measure)">
        {
          page.approach.map((paragraph) => (
            <p class="text-xl md:text-2xl tracking-[-0.02em] leading-snug">{paragraph}</p>
          ))
        }
      </div>
    </div>
  </section>

  <section class="px-6 md:px-10 py-20 md:py-28 border-t border-hair">
    <div class="mx-auto max-w-(--container-content)">
      <p class="lockup text-accent-d">{page.valuesHeading}</p>
      <div class="mt-12 grid gap-x-12 gap-y-10 sm:grid-cols-2">
        {
          page.values.map((value) => (
            <div class="border-t border-hair pt-6">
              <h2 class="text-2xl md:text-3xl font-semibold tracking-[-0.025em]">{value.title}</h2>
              <p class="mt-3 max-w-[40ch] text-base text-grey leading-relaxed">{value.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <ContactCTA lang={lang} contactEmail={CONTACT_EMAIL} />
</BaseLayout>
