---
import BaseLayout from '~/layouts/BaseLayout.astro';
import LegalPage from '~/components/LegalPage.astro';
import ImprintDetails from '~/components/ImprintDetails.astro';
import { t } from '~/i18n';

const lang = 'en' as const;
const s = t(lang).pages.imprint;
---

<BaseLayout title={s.title} description={s.description} lang={lang} background="off">
  <LegalPage heading={s.heading} sections={s.sections}>
    <ImprintDetails lang={lang} />
  </LegalPage>
</BaseLayout>
