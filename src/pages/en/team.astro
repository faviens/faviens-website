---
/*
 * The team page is built on capability rather than on faces: one profile in
 * full, then the disciplines the work draws on, then the seat being filled.
 * No sentence states a number of people, because a young firm that claims a
 * headcount it does not have is making a claim a reader can check.
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import ContactCTA from '~/components/ContactCTA.astro';
import TeamMember from '~/components/TeamMember.astro';
import { t } from '~/i18n';
import { CONTACT_EMAIL } from '~/data/company';
import { PROFILES_DE, PROFILES_EN } from '~/data/careers';

const lang = 'en' as const;
const page = t(lang).servicePages.team;
const disciplines = { de: PROFILES_DE, en: PROFILES_EN }[lang];

const entries = await getCollection('team', (e) => e.data.lang === lang);
entries.sort((a, b) => a.data.order - b.data.order);
const members = await Promise.all(
  entries.map(async (entry) => ({ data: entry.data, Content: (await render(entry)).Content })),
);
---

<BaseLayout title={page.title} description={page.lead} lang={lang}>
  <section class="px-6 md:px-10 pt-40 pb-20">
    <div class="mx-auto max-w-(--container-content)">
      <p class="lockup text-accent-d">{page.heading}</p>
      <h1
        class="mt-8 max-w-[16ch] text-5xl md:text-8xl font-extrabold tracking-[-0.045em] leading-[0.92]"
      >
        {page.heading}
      </h1>
      <p class="mt-10 max-w-(--container-measure) text-lg md:text-xl text-grey leading-relaxed">
        {page.lead}
      </p>
    </div>
  </section>

  <section class="px-6 md:px-10 py-20 md:py-28 border-t border-hair">
    <div class="mx-auto max-w-(--container-content)">
      <!--
        The founder and the seat sit side by side rather than in sequence.
        Stacked one above the other the second read as a vacancy notice
        appended to the page; beside the first it reads as the other half of a
        pair, which is what it is.

        An empty frame rather than a silhouette: a shadowed figure implies a
        person who is already here and is being withheld, a stranger claim than
        the one it avoids. It carries no name, no role and no discipline,
        because everything beyond "a seat is taken" would be invented.
      -->
      <div class="grid gap-x-12 gap-y-16 md:grid-cols-2">
        {
          members.map(({ data, Content }) => (
            <TeamMember
              name={data.name}
              role={data.role}
              photo={data.photo}
              linkedin={data.linkedin}
              portraitLabel={page.portraitLabel}
            >
              <Content />
            </TeamMember>
          ))
        }

        <div>
          <div
            class="w-full max-w-[20rem] aspect-square border border-dashed border-hair flex items-end p-4"
          >
            <span class="lockup text-grey">{page.seatLabel}</span>
          </div>
          <h2 class="mt-8 text-3xl md:text-4xl font-extrabold tracking-[-0.04em] leading-[1.0]">
            {page.openingLabel}
          </h2>
          <p class="mt-8 max-w-(--container-measure) text-lg text-grey leading-relaxed">
            {page.openingBody}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="px-6 md:px-10 py-20 md:py-28 border-t border-hair">
    <div class="mx-auto max-w-(--container-content)">
      <p class="lockup text-accent-d">{page.disciplinesHeading}</p>
      <div class="mt-12 border-t border-hair">
        {
          disciplines.map((discipline, i) => (
            <div class="grid gap-x-8 gap-y-3 md:grid-cols-[4rem_1fr] items-start border-b border-hair py-8">
              <span class="eyebrow text-accent-d md:pt-2" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <h2 class="text-2xl md:text-3xl font-semibold tracking-[-0.025em]">
                  {discipline.title}
                </h2>
                <p class="mt-3 max-w-[52ch] text-base text-grey leading-relaxed">
                  {discipline.summary}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <ContactCTA lang={lang} contactEmail={CONTACT_EMAIL} />
</BaseLayout>
